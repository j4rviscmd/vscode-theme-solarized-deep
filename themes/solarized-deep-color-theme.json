  "tokenColors": [
    {
      "name": "Code comments and comment delimiters",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#586e75",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String literals including quoted strings and template strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "Escape sequences within strings",
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "Numeric literals, booleans, null, and undefined constants",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "Variable names and references",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#A8B3B3"
      }
    },
    {
      "name": "Language keywords, storage types, and modifiers",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Operators including logical and arithmetic",
      "scope": [
        "keyword.operator",
        "keyword.operator.logical",
        "keyword.operator.arithmetic"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Function names, calls, and built-in functions",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "Class names, type names, and type annotations",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "name": "Interface declarations and names",
      "scope": [
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "HTML/XML tag names and tag structures",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "HTML/XML attribute names",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A8B3B3"
      }
    },
    {
      "name": "Object properties and property names",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#A8B3B3"
      }
    },
    {
      "name": "Language-level constants and constant variables",
      "scope": [
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "Module import/export statements and control keywords",
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Punctuation marks: separators, terminators, and accessors",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#A8B3B3"
      }
    },
    {
      "name": "Markdown bold text formatting",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#b58900",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic text formatting",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#A8B3B3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown headings at all levels",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#268bd2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown hyperlinks and link URLs",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "Markdown inline code and fenced code blocks",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "Markdown blockquotes and quoted text",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#586e75",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list items and list markers",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "JSON object keys and property names",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.key.json"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "CSS element selectors, classes, and IDs",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "CSS property names in declarations",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "CSS property values and color values",
      "scope": [
        "support.constant.property-value.css",
        "constant.other.color.rgb-value.css"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "Invalid or illegal syntax and code",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "Deprecated code and constructs",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "Git diff file headers and metadata",
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#586e75"
      }
    },
    {
      "name": "Git diff inserted lines and additions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "name": "Git diff deleted lines and removals",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "Git diff modified lines and changes",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "Regular expression patterns and literals",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    },
    {
      "name": "Regular expression capture groups and grouping constructs",
      "scope": [
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "Regular expression character classes and ranges",
      "scope": [
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    }
  ]
}
