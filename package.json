{
  "name": "solarized-deep",
  "displayName": "Solarized Deep",
  "description": "A deeper, calmer dark theme based on Solarized Dark",
  "version": "0.2.0",
  "publisher": "j4rviscmd",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/j4rviscmd/vscode-theme-solarized-deep"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "solarized",
    "deep",
    "color theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Solarized Deep",
        "uiTheme": "vs-dark",
        "path": "./themes/solarized-deep-color-theme.json"
      }
    ],
    "configuration": {
      "title": "Solarized Deep",
      "properties": {
        "solarizedDeep.depth": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "description": "Depth blend ratio (0=Deep, 100=Osaka). Controls how dark the theme is. Default 80."
        }
      }
    }
  }
}
